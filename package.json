{
  "name": "@forastro/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preversion": "pnpm -w -r run build",
    "lint:affected": "pnpm nx affected -t lint --parallel --exclude=@forastro/nx-astro-plugin",
    "test:affected": "pnpm nx affected -t test --parallel --exclude=@forastro/nx-astro-plugin",
    "build:affected": "pnpm nx affected -t build --parallel",
    "check:affected": "pnpm nx affected -t check --parallel",
    "ci": "pnpm -w install --frozen-lockfile  pnpm run lint:affected  pnpm run test:affected  pnpm run check:affected  pnpm run build:affected"
  },
  "private": true,
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@astrojs/check": "^0.9.10",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^8.57.0",
    "@faker-js/faker": "^9.9.0",
    "@forastro/asciidoc": "^2.3.4",
    "@nx/devkit": "23.2.0",
    "@nx/esbuild": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/plugin": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@swc-node/register": "~1.10.10",
    "@swc/cli": "~0.7.8",
    "@swc/core": "~1.13.3",
    "@swc/helpers": "~0.5.17",
    "@types/node": "24.2.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "astro": "^7.3.2",
    "astro-eslint-parser": "^1.2.2",
    "esbuild": "^0.25.8",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "execa": "^9.6.0",
    "jiti": "2.5.1",
    "jsdom": "~26.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "nx": "23.2.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "verdaccio": "^6.1.6",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource/palanquin": "^5.2.6",
    "@fontsource/raleway": "^5.2.6",
    "@unocss/reset": "^66.4.2",
    "astro-icon": "^1.2.0",
    "sharp": "^0.32.6",
    "unocss": "^66.5.0"
  }
}
