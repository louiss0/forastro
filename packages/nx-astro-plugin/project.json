{
  "name": "@forastro/nx-astro-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nx-astro-plugin/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false
    }
  },
  "tags": ["nx:lib", "nx:lib:ongoing"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "command": "tsup --config tsup.config.ts && node scripts/copy-assets.mjs",
        "cwd": "packages/nx-astro-plugin"
      }
    },
    "lint": {
      "options": {
        "args": ["**/*.ts"]
      }
    }
  }
}
