{
  "$schema": "http://json-schema.org/schema",
  "title": "Add Astro integration",
  "type": "object",
  "properties": {
    "project": { "type": "string" },
    "names": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "packageManager": {
      "type": "string",
      "enum": ["auto", "pnpm", "npm", "yarn", "bun"],
      "default": "auto"
    },
    "skipInstall": { "type": "boolean", "default": false }
  },
  "required": ["project", "names"]
}
