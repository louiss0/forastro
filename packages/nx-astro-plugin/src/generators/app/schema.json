{
  "$schema": "http://json-schema.org/schema",
  "title": "Create Astro app",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "directory": { "type": "string", "default": "apps" },
    "typescript": { "type": "boolean", "default": true },
    "integrations": { "type": "array", "items": { "type": "string" } },
    "eslint": {
      "type": "string",
      "enum": ["auto", "true", "false"],
      "default": "auto"
    },
    "skipInstall": { "type": "boolean", "default": false },
    "packageManager": {
      "type": "string",
      "enum": ["auto", "pnpm", "npm", "yarn", "bun"],
      "default": "auto"
    }
  },
  "required": ["name"]
}
